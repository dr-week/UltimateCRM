{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Directus CRM Collection Schema Reference",
  "description": "Standard Directus collection schema contract for UltimateCRM",
  "collections": [
    {
      "collection": "leads",
      "fields": [
        { "field": "id", "type": "integer", "primary_key": true },
        { "field": "name", "type": "string" },
        { "field": "company", "type": "string" },
        { "field": "email", "type": "string" },
        { "field": "phone", "type": "string" },
        { "field": "status", "type": "string", "choices": ["Lead", "Qualified", "Proposal", "Negotiation", "Closed Won", "Closed Lost"] },
        { "field": "value", "type": "decimal" },
        { "field": "assigned_to", "type": "string" },
        { "field": "notes", "type": "text" },
        { "field": "date_created", "type": "timestamp" }
      ]
    }
  ]
}
